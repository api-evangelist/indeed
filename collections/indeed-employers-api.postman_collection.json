          "name": "Indeed Create an Employer",
          "request": {
            "name": "Indeed Create an Employer",
            "description": {
              "content": "Creates a new employer entity on Indeed. The employer name is required when creating a new employer. An employer must be created before job postings can be associated with it. Uses the patchEmployer mutation internally.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "employers"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"<string>\",\n  \"employerName\": \"<string>\",\n  \"employerAttributes\": {\n    \"employerType\": \"<string>\",\n    \"countrySpecificAttributes\": [\n      {\n        \"country\": \"<string>\",\n        \"websiteUrl\": \"<uri>\",\n        \"phoneNumber\": \"<string>\",\n        \"address\": {\n          \"streetAddress\": \"<string>\",\n          \"streetAddress2\": \"<string>\",\n          \"city\": \"<string>\",\n          \"state\": \"<string>\",\n          \"postalCode\": \"<string>\",\n          \"country\": \"<string>\"\n        }\n      },\n      {\n        \"country\": \"<string>\",\n        \"websiteUrl\": \"<uri>\",\n        \"phoneNumber\": \"<string>\",\n        \"address\": {\n          \"streetAddress\": \"<string>\",\n          \"streetAddress2\": \"<string>\",\n          \"city\": \"<string>\",\n          \"state\": \"<string>\",\n          \"postalCode\": \"<string>\",\n          \"country\": \"<string>\"\n        }\n      }\n    ],\n    \"localeSpecificAttributes\": [\n      {\n        \"locale\": \"<string>\",\n        \"employerName\": \"<string>\",\n        \"employerDescription\": \"<string>\"\n      },\n      {\n        \"locale\": \"<string>\",\n        \"employerName\": \"<string>\",\n        \"employerDescription\": \"<string>\"\n      }\n    ]\n  }\n}",
