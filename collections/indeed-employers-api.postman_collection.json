      "id": "f8a1e8be-d575-44f1-b644-363187213907",
      "name": "Employers",
      "description": {
        "content": "Operations for creating and managing employer profiles on Indeed. Employer entities must be created before job postings can be associated with them. Supports global attributes such as employer name and type, as well as country-specific attributes like website URL and phone number.",
        "type": "text/plain"
      },
