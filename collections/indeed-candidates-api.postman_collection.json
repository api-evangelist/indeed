        {
          "id": "01f4f17e-ec10-46eb-9b5e-e72a8c784560",
          "name": "Indeed List Candidates for an Employer",
          "request": {
            "name": "Indeed List Candidates for an Employer",
            "description": {
              "content": "Retrieves a paginated list of candidates who have applied to jobs posted by the specified employer. Part of the Candidate Sync APIs, this endpoint returns candidate and application information including the most recent unacknowledged applications.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "employers",
                ":employerId",
                "candidates"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>",
                  "description": "Filter candidates by application status."
                },
                {
                  "disabled": false,
                  "key": "jobPostingId",
                  "value": "<string>",
                  "description": "Filter candidates by job posting ID."
                },
                {
                  "disabled": false,
                  "key": "after",
                  "value": "<string>",
                  "description": "Cursor for forward pagination."
                },
                {
                  "disabled": false,
                  "key": "first",
                  "value": "25",
                  "description": "Number of candidates to return (max 100)."
                },
                {
                  "disabled": false,
                  "key": "since",
                  "value": "<dateTime>",
                  "description": "Return only candidates who applied after this timestamp."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "employerId",
                  "description": "(Required) The unique identifier of the employer."
                }
              ]
            },
            "header": [
